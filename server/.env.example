NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:xxxxxxxx
MONGODB_URI=mongodb://xxxxxxxxxx/vandevi_infrastructure

# Firebase Admin Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=inquiries@vandeviinfrastructure.com
SMTP_PASS=your-app-specific-password
ADMIN_ALERT_EMAIL=leads@vandeviinfrastructure.com